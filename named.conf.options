options {
    directory "/var/cache/bind";

    listen-on { any; };
    listen-on-v6 { none; };

    recursion no;
    allow-recursion { none; };
    allow-query-cache { none; };

    allow-query { 127.0.0.1; 192.168.14.0/24; 10.0.2.0/24; };
    allow-transfer { 127.0.0.1; 192.168.14.0/24; 10.0.2.0/24; };

    dnssec-validation no;

    blackhole {
        169.254.0.0/16;
        224.0.0.0/4;
    };

    version "not currently available";
    server-id none;
    minimal-responses yes;
    auth-nxdomain no;
    notify no;
};
